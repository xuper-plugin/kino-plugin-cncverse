{
  "id": "cncverse",
  "name": "CNCVerse",
  "version": "2.0.0",
  "apiVersion": 9,
  "entry": "plugin.js",
  "description": "Puente al servidor CNCVerse (protocolo de Stremio): el servidor mantiene catálogos y fuentes, Kino solo los muestra.",
  "author": "xuper-plugin",
  "homepage": "https://github.com/xuper-plugin/kino-plugin-cncverse",
  "hosts": [
    "cncverse.dpdns.org"
  ],
  "capabilities": [
    "search",
    "scopedSearch",
    "home",
    "browse",
    "episodes",
    "resolve",
    "channels",
    "subtitles",
    "download"
  ],
  "streamHosts": "any",
  "liveStreamHosts": "any",
  "categories": [
    "movies",
    "series",
    "live"
  ],
  "color": "#6F4FF5",
  "settings": [
    {
      "key": "homeRows",
      "type": "select",
      "label": "Filas en Inicio",
      "labelEn": "Rows on Home",
      "default": "4",
      "options": [
        {
          "value": "2",
          "label": "2",
          "labelEn": "2"
        },
        {
          "value": "4",
          "label": "4",
          "labelEn": "4"
        },
        {
          "value": "8",
          "label": "8",
          "labelEn": "8"
        }
      ],
      "hint": "Cada fila es un catálogo del servidor. Menos filas cargan más rápido.",
      "hintEn": "Each row is one of the server's catalogs. Fewer rows load faster."
    },
    {
      "key": "sectionPage",
      "type": "select",
      "label": "Pestañas de la sección",
      "labelEn": "Section tabs",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "Catálogos 1–8",
          "labelEn": "Catalogs 1–8"
        },
        {
          "value": "2",
          "label": "Catálogos 9–16",
          "labelEn": "Catalogs 9–16"
        },
        {
          "value": "3",
          "label": "Catálogos 17–24",
          "labelEn": "Catalogs 17–24"
        }
      ],
      "hint": "Ocho catálogos a la vez, con las secciones del servidor.",
      "hintEn": "Eight catalogs at a time, with the server's own sections."
    },
    {
      "key": "statusSection",
      "type": "section",
      "label": "Estado",
      "labelEn": "Status"
    },
    {
      "key": "serverStatus",
      "type": "status",
      "label": "Servidor",
      "labelEn": "Server"
    },
    {
      "key": "checkConn",
      "type": "action",
      "label": "Verificar conexión",
      "labelEn": "Check connection"
    }
  ],
  "telemetry": true,
  "section": {
    "label": "CNCVerse",
    "labelEn": "CNCVerse"
  },
  "icon": "icon.png",
  "theme": {
    "accent": "#6F4FF5",
    "onAccent": "#FFFFFF",
    "background": "#07050D",
    "surface": "#15111F",
    "highlight": "#C9BBFF"
  }
}
