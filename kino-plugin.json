{
  "id": "cncverse",
  "name": "CNCVerse",
  "version": "1.3.0",
  "apiVersion": 9,
  "entry": "plugin.js",
  "description": "Películas, series, anime, resúmenes y TV deportiva en vivo desde CNCVerse Bridge. Funciona al instalarlo, sin configurar nada.",
  "author": "xuper-plugin",
  "homepage": "https://github.com/xuper-plugin/kino-plugin-cncverse",
  "hosts": [
    "cncverse.dpdns.org"
  ],
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve",
    "download",
    "channels",
    "scopedSearch"
  ],
  "streamHosts": "any",
  "liveStreamHosts": "any",
  "categories": [
    "movies",
    "series"
  ],
  "color": "#6F4FF5",
  "telemetry": true,
  "settings": [
    {
      "key": "accessSection",
      "type": "section",
      "label": "Acceso",
      "labelEn": "Access"
    },
    {
      "key": "address",
      "type": "password",
      "label": "Tu propio perfil (opcional)",
      "labelEn": "Your own profile (optional)",
      "hint": "Pega tu URL de CNCVerse para usar tu perfil.",
      "hintEn": "Paste your CNCVerse URL to use your own profile."
    },
    {
      "key": "playSection",
      "type": "section",
      "label": "Reproducción",
      "labelEn": "Playback"
    },
    {
      "key": "quality",
      "type": "select",
      "label": "Calidad preferida",
      "labelEn": "Preferred quality",
      "default": "1080",
      "options": [
        {
          "value": "max",
          "label": "La más alta (4K)",
          "labelEn": "Highest (4K)"
        },
        {
          "value": "1080",
          "label": "Hasta 1080p",
          "labelEn": "Up to 1080p"
        },
        {
          "value": "720",
          "label": "Hasta 720p",
          "labelEn": "Up to 720p"
        }
      ]
    },
    {
      "key": "maxSize",
      "type": "select",
      "label": "Tamaño máximo del archivo",
      "labelEn": "Maximum file size",
      "hint": "Los archivos más pesados pasan al final.",
      "hintEn": "Heavier files go to the end.",
      "default": "10",
      "options": [
        {
          "value": "0",
          "label": "Sin límite",
          "labelEn": "No limit"
        },
        {
          "value": "10",
          "label": "10 GB",
          "labelEn": "10 GB"
        },
        {
          "value": "5",
          "label": "5 GB",
          "labelEn": "5 GB"
        },
        {
          "value": "2.5",
          "label": "2,5 GB",
          "labelEn": "2.5 GB"
        }
      ]
    },
    {
      "key": "sourcesSection",
      "type": "section",
      "label": "Fuentes",
      "labelEn": "Sources"
    },
    {
      "key": "sources",
      "type": "text",
      "label": "Fuentes de video",
      "labelEn": "Video sources",
      "default": "all",
      "hint": "all, o por comas: HDHub4U, Kisskh, Movix, Re:ANIME…",
      "hintEn": "all, or comma-separated: HDHub4U, Kisskh, Movix, Re:ANIME…"
    },
    {
      "key": "searchIn",
      "type": "select",
      "label": "Buscar en",
      "labelEn": "Search in",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "Todas las fuentes",
          "labelEn": "All sources"
        },
        {
          "value": "main",
          "label": "Solo las principales (más rápido)",
          "labelEn": "Main ones only (faster)"
        }
      ]
    },
    {
      "key": "prefer",
      "type": "select",
      "label": "Preferir",
      "labelEn": "Prefer",
      "default": "file",
      "options": [
        {
          "value": "file",
          "label": "Archivo directo",
          "labelEn": "Direct file"
        },
        {
          "value": "hls",
          "label": "HLS (listas)",
          "labelEn": "HLS (playlists)"
        }
      ]
    },
    {
      "key": "homeSection",
      "type": "section",
      "label": "Inicio",
      "labelEn": "Home"
    },
    {
      "key": "homeRows",
      "type": "toggle",
      "label": "Filas en Inicio",
      "labelEn": "Home rows",
      "hint": "Lo último de algunas fuentes aparece en el Inicio de Kino.",
      "hintEn": "The latest of some sources appears on Kino's Home.",
      "default": true
    },
    {
      "key": "liveSection",
      "type": "section",
      "label": "En vivo",
      "labelEn": "Live"
    },
    {
      "key": "hideUpcoming",
      "type": "toggle",
      "label": "Ocultar eventos próximos",
      "labelEn": "Hide upcoming events",
      "hint": "Los que aún no tienen señal.",
      "hintEn": "The ones with no signal yet.",
      "default": true
    },
    {
      "key": "jioLangs",
      "type": "text",
      "label": "Idiomas de JioTV",
      "labelEn": "JioTV languages",
      "default": "English,Hindi,Tamil,Telugu",
      "hint": "all, o por comas: English, Hindi, Tamil, Telugu, Marathi…",
      "hintEn": "all, or comma-separated: English, Hindi, Tamil, Telugu, Marathi…"
    },
    {
      "key": "toolsSection",
      "type": "section",
      "label": "Herramientas",
      "labelEn": "Tools"
    },
    {
      "key": "health",
      "type": "status",
      "label": "Estado del puente",
      "labelEn": "Bridge status"
    },
    {
      "key": "cache",
      "type": "status",
      "label": "Caché",
      "labelEn": "Cache"
    },
    {
      "key": "probe",
      "type": "action",
      "label": "Comprobar el puente",
      "labelEn": "Check the bridge"
    },
    {
      "key": "clearCache",
      "type": "action",
      "label": "Vaciar caché",
      "labelEn": "Clear cache",
      "confirm": "¿Vaciar la caché de listas y fichas?",
      "confirmEn": "Clear the cache of lists and titles?"
    }
  ],
  "secrets": {
    "bridgeCode": "kino-sealed:v1:0mkle0flc-78CKwJzPS3h6oSbctKL_0Eht0lFEFpDXn-v8cC6-4vp_57IkkDx9V9WS1EHY85Oc390I33JkDI6-p_P2egUhhwaUk"
  },
  "section": {
    "label": "CNCVerse",
    "labelEn": "CNCVerse"
  },
  "theme": {
    "accent": "#6F4FF5",
    "onAccent": "#FFFFFF",
    "background": "#07050D",
    "surface": "#15111F",
    "highlight": "#C9BBFF"
  }
}
